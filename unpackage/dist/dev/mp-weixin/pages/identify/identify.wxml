<view class="identify-page"><view class="header"><view class="header-content"><text class="title">智能识别</text><text class="subtitle">上传照片，AI识别中草药</text></view></view><view class="upload-section"><view class="upload-card"><view wx:if="{{a}}" class="upload-area"><view class="upload-icon-wrapper"><text class="upload-icon">📷</text></view><text class="upload-text">点击下方按钮上传照片</text><text class="upload-hint">支持 JPG、PNG 格式</text></view><view wx:if="{{b}}" class="identifying-area"><view class="loading-wrapper"><view class="loading-spinner"></view></view><text class="identifying-text">AI正在识别中...</text></view><view wx:if="{{c}}" class="result-area"><view wx:if="{{d}}" class="result-image"><image class="result-img" src="{{e}}" mode="aspectFill"></image></view><view wx:else class="result-image result-image-placeholder"><text class="result-image-text">金银花</text></view><view class="result-header"><view class="result-name-section"><text class="result-name">{{f}}</text><text class="result-latin">{{g}}</text></view><view class="confidence-section"><view class="confidence-label"><text class="confidence-icon">✨</text><text class="confidence-text">可信度</text></view><text class="confidence-value">{{h}}%</text></view></view><view class="category-tag"><text class="category-tag-text">{{i}}</text></view></view><view class="button-group"><view wx:if="{{j}}" class="btn btn-primary" bindtap="{{k}}"><text class="btn-icon">📷</text><text class="btn-text">拍照识别</text></view><view wx:if="{{l}}" class="btn btn-outline" bindtap="{{m}}"><text class="btn-icon">📁</text><text class="btn-text-outline">相册选择</text></view><view wx:if="{{n}}" class="btn btn-primary btn-full" bindtap="{{o}}"><text class="btn-text">重新识别</text></view></view></view></view><view wx:if="{{p}}" class="detail-section"><view class="detail-card"><view class="detail-header"><text class="detail-icon">ℹ️</text><text class="detail-title">详细信息</text></view><view class="detail-content"><view class="detail-item"><text class="detail-label">拉丁学名</text><text class="detail-value">{{q}}</text></view><view class="detail-item"><text class="detail-label">药用部位</text><text class="detail-value">{{r}}</text></view><view class="detail-item"><text class="detail-label">性味</text><text class="detail-value">{{s}}</text></view><view class="detail-item"><text class="detail-label">归经</text><text class="detail-value">{{t}}</text></view><view class="detail-item"><text class="detail-label">功效</text><text class="detail-value">{{v}}</text></view><view class="detail-item"><text class="detail-label">主治</text><text class="detail-value">{{w}}</text></view></view></view></view><view wx:if="{{x}}" class="tip-section"><view class="tip-card"><view class="tip-header"><text class="tip-icon">💡</text><text class="tip-title">拍摄建议</text></view><view class="tip-list"><text class="tip-item">• 确保光线充足，避免阴影遮挡</text><text class="tip-item">• 尽量拍摄草药的全貌</text><text class="tip-item">• 保持画面清晰，避免模糊</text><text class="tip-item">• 背景简洁，突出主体</text></view></view></view><view class="custom-tabbar"><view class="tabbar-item" bindtap="{{y}}"><text class="tab-icon">🏠</text><text class="tab-text">首页</text></view><view class="tabbar-item" bindtap="{{z}}"><text class="tab-icon active">📷</text><text class="tab-text active">识别</text></view><view class="tabbar-item" bindtap="{{A}}"><text class="tab-icon">📚</text><text class="tab-text">百科</text></view><view class="tabbar-item" bindtap="{{B}}"><text class="tab-icon">👤</text><text class="tab-text">我的</text></view></view></view>
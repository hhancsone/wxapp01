<view class="collection-page"><view class="header"><view class="back-btn" bindtap="{{a}}"><text class="back-icon">‹</text></view><text class="page-title">我的收藏</text><view class="placeholder"></view></view><view wx:if="{{b}}" class="collection-list"><view wx:for="{{c}}" wx:for-item="item" wx:key="g" class="collection-item" bindtap="{{item.h}}"><view class="{{['item-image', d]}}"><image wx:if="{{item.a}}" class="herb-img" src="{{item.b}}" mode="aspectFill"></image><text wx:else class="item-image-text">{{item.c}}</text></view><view class="item-info"><text class="item-name">{{item.d}}</text><text class="item-time">{{item.e}}</text></view><view class="delete-btn" catchtap="{{item.f}}"><text class="delete-icon">🗑️</text></view></view></view><view wx:else class="empty-state"><text class="empty-icon">⭐</text><text class="empty-text">暂无收藏</text><text class="empty-hint">快去收藏喜欢的药材吧</text></view><view class="custom-tabbar"><view class="tabbar-item" bindtap="{{e}}"><text class="tab-icon">🏠</text><text class="tab-text">首页</text></view><view class="tabbar-item" bindtap="{{f}}"><text class="tab-icon">📷</text><text class="tab-text">识别</text></view><view class="tabbar-item" bindtap="{{g}}"><text class="tab-icon">📚</text><text class="tab-text">百科</text></view><view class="tabbar-item" bindtap="{{h}}"><text class="tab-icon active">👤</text><text class="tab-text active">我的</text></view></view></view>
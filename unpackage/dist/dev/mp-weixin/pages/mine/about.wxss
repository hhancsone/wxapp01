
page {
		background: #f5f5f5;
		height: 100%;
}
.about-page {
		min-height: 100vh;
		background: #f5f5f5;
		padding-bottom: 120rpx;
}
.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 20rpx 32rpx;
		background: #ffffff;
}
.back-btn {
		width: 60rpx;
		height: 60rpx;
		display: flex;
		align-items: center;
		justify-content: center;
}
.back-icon {
		font-size: 48rpx;
		color: #1f2937;
		font-weight: bold;
}
.page-title {
		font-size: 34rpx;
		font-weight: bold;
		color: #1f2937;
}
.placeholder {
		width: 60rpx;
}
.about-content {
		padding: 40rpx 32rpx;
}
.app-logo {
		display: flex;
		justify-content: center;
		margin-bottom: 24rpx;
}
.logo-icon {
		font-size: 120rpx;
}
.app-name {
		display: block;
		text-align: center;
		font-size: 40rpx;
		font-weight: bold;
		color: #1f2937;
		margin-bottom: 12rpx;
}
.app-version {
		display: block;
		text-align: center;
		font-size: 26rpx;
		color: #9ca3af;
		margin-bottom: 48rpx;
}
.intro-section {
		background: #ffffff;
		border-radius: 24rpx;
		padding: 32rpx;
		margin-bottom: 24rpx;
}
.section-title {
		display: block;
		font-size: 30rpx;
		font-weight: bold;
		color: #1f2937;
		margin-bottom: 20rpx;
}
.section-content {
		display: block;
		font-size: 26rpx;
		color: #6b7280;
		line-height: 1.8;
}
.feature-list {
		margin-top: 8rpx;
}
.feature-item {
		display: flex;
		align-items: center;
		margin-bottom: 20rpx;
}
.feature-item:last-child {
		margin-bottom: 0;
}
.feature-icon {
		font-size: 32rpx;
		margin-right: 16rpx;
}
.feature-text {
		font-size: 26rpx;
		color: #6b7280;
}
.copyright {
		text-align: center;
		padding: 40rpx 0;
}
.copyright-text {
		display: block;
		font-size: 24rpx;
		color: #9ca3af;
		margin-bottom: 8rpx;
}
.custom-tabbar {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		display: flex;
		justify-content: space-around;
		align-items: center;
		height: 100rpx;
		background: #ffffff;
		box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
		padding-bottom: env(safe-area-inset-bottom);
}
.tabbar-item {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
}
.tab-icon {
		font-size: 40rpx;
		margin-bottom: 4rpx;
}
.tab-text {
		font-size: 22rpx;
		color: #9ca3af;
}
.tab-icon.active,
	.tab-text.active {
		color: #10b981;
}

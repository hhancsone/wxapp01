<view class="identify-records-page"><view class="header"><view class="back-btn" bindtap="{{a}}"><text class="back-icon">‹</text></view><text class="page-title">识别记录</text><view class="placeholder"></view></view><view wx:if="{{b}}" class="records-list"><view wx:for="{{c}}" wx:for-item="item" wx:key="f" class="record-item" bindtap="{{item.g}}"><view class="item-icon"><image wx:if="{{item.a}}" class="herb-img" src="{{item.b}}" mode="aspectFill"></image><text wx:else class="icon-text">🔍</text></view><view class="item-info"><text class="item-name">{{item.c}}</text><view class="item-meta"><text class="item-confidence">匹配度: {{item.d}}%</text><text class="item-time">{{item.e}}</text></view></view><view class="arrow-icon"><text class="arrow">›</text></view></view></view><view wx:else class="empty-state"><text class="empty-icon">🔍</text><text class="empty-text">暂无识别记录</text><text class="empty-hint">快去识别药材吧</text></view><view class="custom-tabbar"><view class="tabbar-item" bindtap="{{d}}"><text class="tab-icon">🏠</text><text class="tab-text">首页</text></view><view class="tabbar-item" bindtap="{{e}}"><text class="tab-icon">📷</text><text class="tab-text">识别</text></view><view class="tabbar-item" bindtap="{{f}}"><text class="tab-icon">📚</text><text class="tab-text">百科</text></view><view class="tabbar-item" bindtap="{{g}}"><text class="tab-icon active">👤</text><text class="tab-text active">我的</text></view></view></view>